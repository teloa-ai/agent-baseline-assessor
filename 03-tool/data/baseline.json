 "chapters": [
  {
   "id": "V1",
   "name": "身份与认证",
   "lead": "每个请求都要确定两个身份：发起的人和执行的 Agent。两者都由平台从可信来源得出，不采信请求或模型自报的身份。",
   "stage": "行为之前",
   "question": "谁在发起，哪个 Agent 在执行"
  },
  {
   "id": "V2",
   "name": "委托与有效权限",
   "lead": "Agent 的权限上限来自它代表的人，而不是平台自己持有的凭证。有效权限按 3.14 取交集，并且只能沿委托链收窄。",
   "stage": "行为之前",
   "question": "代表谁，权限上限是多少"
  },
  {
   "id": "V3",
   "name": "授权决策",
   "lead": "每一次工具调用在执行前都要经过平台的策略检查。能不能做、要不要人确认，由平台按工具和参数判定，模型说的不算。",
   "stage": "行为之前",
   "question": "这一次操作能不能做，要不要人确认"
  },
  {
   "id": "V4",
   "name": "凭证与出口执行",
   "lead": "出口网关是 Agent 访问下游系统和互联网的唯一通道，真实凭证只在这里注入。没有绕开网关的路径，凭证也只发往它被授权的目标，「不漏」才有保证。",
   "stage": "行为之中",
   "question": "请求怎么出去，凭证怎么注入"
  },
  {
   "id": "V5",
   "name": "执行隔离",
   "lead": "Agent 执行代码、命令、浏览器和端侧操作时，要被限定在可控的边界内。Harness 自身的配置也要由企业统一管控，不能由员工或代码仓库随意改写。",
   "stage": "行为之中",
   "question": "代码、命令、浏览器和扩展在什么边界内运行"
  },
  {
   "id": "V6",
   "name": "上下文与不可信输入",
   "lead": "进入上下文的不可信内容只能当作数据，不能当作指令。会话读入不可信内容之后，Agent 能做的事要随之收紧。",
   "stage": "行为之中",
   "question": "读进来的内容能不能影响决策"
  },
  {
   "id": "V7",
   "name": "输出与可见性",
   "lead": "权限检查要延伸到输出的那一刻。结果给谁看、会不会外泄，都要按接收方再判断一次。",
   "stage": "行为之后",
   "question": "结果给谁看，会不会外泄"
  },
  {
   "id": "V8",
   "name": "数据、记忆与产出物",
   "lead": "Agent 留下的东西会被后来的人检索到。检索、记忆和产出物都要带着来源和权限标签，读取时按当前用户重新作出授权判定。",
   "stage": "全周期",
   "question": "数据怎么检索、沉淀和留存"
  },
  {
   "id": "V9",
   "name": "生命周期与治理",
   "lead": "每个 Agent 都要有登记、有负责人、有复核，从创建到下线全程可管。平台提供方自身的访问也在治理范围之内。",
   "stage": "全周期",
   "question": "谁管 Agent，从登记到下线"
  },
  {
   "id": "V10",
   "name": "审计、检测与响应",
   "lead": "出了事，要能还原谁让哪个 Agent 基于什么内容做了什么，并能在分钟级别内止损。本章覆盖记录、检测、撤销、紧急停用和事后恢复。",
   "stage": "全周期",
   "question": "怎么记录、发现和止损"
  }
 ],
