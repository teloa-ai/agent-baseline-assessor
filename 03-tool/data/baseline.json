 "components": [
  {
   "name": "身份层",
   "duty": "企业 IdP、目录、SCIM，签发用户、Agent 和工作负载身份",
   "trust": "可信"
  },
  {
   "name": "交互渠道",
   "duty": "Web、IM、邮件、IDE、API 等入口，负责身份映射和输出的可见范围",
   "trust": "可信；经渠道进入的内容不可信"
  },
  {
   "name": "Harness",
   "duty": "Agent 循环、上下文管理、工具层、安全控制、编排、扩展接口",
   "trust": "平台托管时可信；在员工终端运行时不可信，按 V5.4"
  },
  {
   "name": "策略决策点",
   "duty": "计算有效权限、判定风险等级、决定是否审批",
   "trust": "可信"
  },
  {
   "name": "出口网关",
   "duty": "统一出口，注入凭证、校验目标、限流、吊销；凭证库归属于此",
   "trust": "可信"
  },
  {
   "name": "下游系统",
   "duty": "被访问的 SaaS、内部 API、MCP Server、数据库",
   "trust": "自行作出授权判定；返回内容不可信"
  },
  {
   "name": "数据层",
   "duty": "知识库、RAG、记忆、产出物",
   "trust": "可信；存储的内容可能被污染，按不可信内容处理"
  },
  {
   "name": "执行环境",
   "duty": "执行代码、命令、文件和浏览器操作",
   "trust": "不可信，可能被攻陷"
  },
  {
   "name": "管理面",
   "duty": "Agent 登记、连接器、托管策略、生命周期",
   "trust": "可信"
  },
  {
   "name": "审计",
   "duty": "记录、调阅、导出与留存，以及检测与响应",
   "trust": "可信"
  }
 ],
