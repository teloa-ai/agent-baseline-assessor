flowchart TB
    subgraph agent["Agent = Modell + Harness"]
        subgraph harness["Harness"]
            m0["Agentenschleife<br/>Wiederholte Modell- und Tool-Aufrufe"]
            m1["Kontextverwaltung<br/>Kontext aufbauen und verdichten"]
            m2["Tool-Schicht<br/>Dateien, Befehle, MCP"]
            m3["Sicherheitskontrollen<br/>Berechtigungen, Freigaben, Hooks"]
            m4["Orchestrierung<br/>Planung, Unteragenten"]
            m5["Erweiterungsschnittstellen<br/>Skills, Plugins, MCP"]
        end
        model["Modell (LLM)<br/>Ausgabe gilt als Anfrage"]
        harness <-->|"Aufruf"| model
    end
    framework["Framework (optional)<br/>Abstraktionen für Modellaufrufe und Tools, z. B. LangChain, OpenAI Agents SDK"]
    runtime["Laufzeit (Runtime)<br/>Dauerhafte Ausführung, Zustand, Wiederherstellung, z. B. LangGraph, Temporal"]
    execution["Ausführungsumgebung<br/>Sandbox, VM, Terminal"]
    harness -.->|"Kann darauf aufbauen"| framework
    framework -.->|"Kann darauf laufen"| runtime
    harness -->|"Tools ausführen"| execution
    classDef focus fill:#183a5a,stroke:#183a5a,color:#fff;
    classDef untrusted fill:#fbf3ea,stroke:#b4561c,color:#5e4a3c,stroke-dasharray:5 3;
    classDef foundation fill:#e4e8ec,stroke:#b8bfc8,color:#14171c;
    class m3 focus;
    class model,execution untrusted;
    class runtime foundation;
