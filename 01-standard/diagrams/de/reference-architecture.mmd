    model["Modell (LLM)<br/>Ausgabe gilt als Anfrage<br/>V6"]
    data["Datenschicht<br/>Wissensbasis, Speicher<br/>V8"]
    execution["Ausführungsumgebung<br/>Sandbox oder Endgerät<br/>V5"]
