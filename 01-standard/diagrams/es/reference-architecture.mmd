flowchart LR
    identity["Capa de identidad<br/>IdP empresarial, directorio, SCIM; identidades de usuarios, agentes y cargas de trabajo<br/>V1"]
    n0["Usuario<br/>Empleado<br/>o evento del sistema"]
    n1["Canal de interacción<br/>Web, IM<br/>IDE, API<br/>V1.2 · V7"]
    n2["Harness<br/>Bucle del agente<br/>Hooks de seguridad<br/>V3 · V5 · V6"]
    n3["Punto de decisión de políticas<br/>Permisos efectivos<br/>Clasificación de riesgo<br/>V2 · V3"]
    n4["Pasarela de salida<br/>Inyección de credenciales<br/>Validación del destino<br/>V4"]
    n5["Sistemas posteriores<br/>SaaS, API<br/>MCP, bases de datos<br/>V4"]
    model["Modelo (LLM)<br/>Salida tratada como solicitud<br/>V6"]
    data["Capa de datos<br/>Conocimiento, memoria<br/>V8"]
    execution["Entorno de ejecución<br/>Sandbox o terminal<br/>V5"]
    manage["Plano de gestión<br/>Registro de agentes, conectores, políticas, ciclo de vida<br/>V9"]
    audit["Auditoría<br/>Usuarios, agentes, delegación, parámetros y aprobaciones<br/>V10"]
    n0 --> n1 --> n2 --> n3 --> n4 --> n5
    model <-->|"Llamada"| n2
    data <-->|"Recuperar"| n2
    n2 -->|"Ejecutar"| execution
    execution -->|"Salida"| n4
    n5 -.->|"El contenido devuelto se trata como no confiable"| n2
    classDef controls fill:#e6edf5,stroke:#9db4cf,color:#14171c;
    classDef focus fill:#183a5a,stroke:#183a5a,color:#fff;
    classDef untrusted fill:#fbf3ea,stroke:#b4561c,color:#5e4a3c,stroke-dasharray:5 3;
    classDef component fill:#fff,stroke:#cfd5dc,color:#14171c;
    class identity,n3,n4,manage,audit controls;
    class n2 focus;
    class model,execution untrusted;
    class n1,data component;
