flowchart TB
    subgraph agent["Agent = modèle + harness"]
        subgraph harness["Harness"]
            m0["Boucle de l'agent<br/>Appels répétés au modèle et aux outils"]
            m1["Gestion du contexte<br/>Assembler et compresser le contexte"]
            m2["Couche d'outils<br/>Fichiers, commandes, MCP"]
            m3["Contrôles de sécurité<br/>Permissions, approbations, hooks"]
            m4["Orchestration<br/>Planification, sous-agents"]
            m5["Interfaces d'extension<br/>Skills, plugins, MCP"]
        end
        model["Modèle (LLM)<br/>Sortie traitée comme une demande"]
        harness <-->|"Appel"| model
    end
    framework["Cadre (facultatif)<br/>Abstractions pour les appels et les outils, par ex. LangChain, OpenAI Agents SDK"]
    runtime["Runtime<br/>Exécution persistante, état, reprise, par ex. LangGraph, Temporal"]
    execution["Environnement d'exécution<br/>Sandbox, VM, terminal"]
    harness -.->|"Peut se baser sur"| framework
    framework -.->|"Peut fonctionner sur"| runtime
    harness -->|"Exécuter les outils"| execution
    classDef focus fill:#183a5a,stroke:#183a5a,color:#fff;
    classDef untrusted fill:#fbf3ea,stroke:#b4561c,color:#5e4a3c,stroke-dasharray:5 3;
    classDef foundation fill:#e4e8ec,stroke:#b8bfc8,color:#14171c;
    class m3 focus;
    class model,execution untrusted;
    class runtime foundation;
