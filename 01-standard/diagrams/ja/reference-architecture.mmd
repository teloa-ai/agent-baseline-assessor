    n4["出口ゲートウェイ<br/>資格情報注入<br/>送信先検証<br/>V4"]
    n5["下流システム<br/>SaaS、API<br/>MCP、データベース<br/>V4"]
    model["モデル（LLM）<br/>出力は要求として扱う<br/>V6"]
    data["データ層<br/>知識ベース、記憶<br/>V8"]
