flowchart LR
    identity["Identity layer<br/>Enterprise IdP, directory, SCIM; issues identities for users, agents, and workloads<br/>V1"]
    n0["User<br/>Employee<br/>or system event"]
    n1["Interaction channel<br/>Web, IM<br/>IDE, API<br/>V1.2 · V7"]
    n2["Harness<br/>Agent loop<br/>Security hooks<br/>V3 · V5 · V6"]
    n3["Policy decision point<br/>Effective permissions<br/>Risk classification<br/>V2 · V3"]
    n4["Egress gateway<br/>Credential injection<br/>Destination checks<br/>V4"]
    n5["Downstream systems<br/>SaaS, APIs<br/>MCP, databases<br/>V4"]
    model["Model (LLM)<br/>Output is only a request<br/>V6"]
    data["Data layer<br/>Knowledge, memory<br/>V8"]
    execution["Execution environment<br/>Sandbox or endpoint<br/>V5"]
    manage["Management plane<br/>Agent registration, connectors, managed policies, lifecycle<br/>V9"]
    audit["Audit<br/>Users, agents, delegation, tool parameters, approvals<br/>V10"]
    n0 --> n1 --> n2 --> n3 --> n4 --> n5
    model <-->|"Call"| n2
    data <-->|"Retrieve"| n2
    n2 -->|"Execute"| execution
    execution -->|"Egress"| n4
    n5 -.->|"Returned content is treated as untrusted"| n2
    classDef controls fill:#e6edf5,stroke:#9db4cf,color:#14171c;
    classDef focus fill:#183a5a,stroke:#183a5a,color:#fff;
    classDef untrusted fill:#fbf3ea,stroke:#b4561c,color:#5e4a3c,stroke-dasharray:5 3;
    classDef component fill:#fff,stroke:#cfd5dc,color:#14171c;
    class identity,n3,n4,manage,audit controls;
    class n2 focus;
    class model,execution untrusted;
    class n1,data component;
