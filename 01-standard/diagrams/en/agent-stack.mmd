flowchart TB
    subgraph agent["Agent = model + harness"]
        subgraph harness["Harness"]
            m0["Agent loop<br/>Repeated model and tool calls"]
            m1["Context management<br/>Assemble and compress context"]
            m2["Tool layer<br/>Files, commands, MCP"]
            m3["Security controls<br/>Permissions, approvals, hooks"]
            m4["Orchestration<br/>Planning, sub-agents"]
            m5["Extension interfaces<br/>Skills, plugins, MCP"]
        end
        model["Model (LLM)<br/>Output is only a request"]
        harness <-->|"Call"| model
    end
    framework["Framework (optional)<br/>Development abstractions for model calls and tools, e.g. LangChain, OpenAI Agents SDK"]
    runtime["Runtime<br/>Persistent execution, state, recovery, e.g. LangGraph, Temporal"]
    execution["Execution environment<br/>Sandbox, VM, terminal"]
    harness -.->|"May build on"| framework
    framework -.->|"May run on"| runtime
    harness -->|"Execute tools"| execution
    classDef focus fill:#183a5a,stroke:#183a5a,color:#fff;
    classDef untrusted fill:#fbf3ea,stroke:#b4561c,color:#5e4a3c,stroke-dasharray:5 3;
    classDef foundation fill:#e4e8ec,stroke:#b8bfc8,color:#14171c;
    class m3 focus;
    class model,execution untrusted;
    class runtime foundation;
